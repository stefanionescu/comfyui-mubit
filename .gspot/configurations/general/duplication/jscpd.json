{
    "mode": "strict",
    "minLines": 8,
    "minTokens": 40,
    "absolute": true,
    "gitignore": true,
    "ignorePattern": [
        "import\\s[^;]*?from\\s*['\"][^'\"]+['\"]\\s*;"
    ],
    "ignore": [
        "**/*.md",
        "**/*.mdx",
        "**/.DS_Store",
        "**/.venv/**",
        "**/node_modules/**",
        "**/__pycache__/**",
        "**/*.pyc",
        "**/.env",
        "**/.env.*",
        "**/.artifacts/**",
        "**/.mise.local.toml",
        ".gspot/**",
        "ruff.toml",
        "pyrightconfig.json",
        ".markdownlint.jsonc",
        ".editorconfig",
        "prettier.config.mjs",
        ".prettierignore",
        "example_workflows/assets/hosts/*.png",
        "**/venv/**",
        "**/.dev.vars",
        "**/.dev.vars.*",
        "**/bun.lock",
        "**/.env*",
        "src/nodes/**"
    ]
}
